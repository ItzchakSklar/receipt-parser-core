# Read by docker-compose.yml for image tags and container env vars - copy to
# ".env" (same directory as docker-compose.yml) and fill in for a real deployment.
# Not used by `pnpm dev`/`uvicorn --reload` - see backend/.env.example for that.

# Set by the GitHub Actions deploy job automatically (as ghcr.io/<owner>/<repo>);
# only needed here for a manual `docker compose pull` on the server outside of CI.
IMAGE_BASE=ghcr.io/<owner>/<repo>
TAG=latest

SECRET_KEY=change-this-super-secret-key-in-production
CORS_ORIGINS=http://localhost

# Hosted Turso (libSQL) database - the only storage for users, invoices and the
# receipt files themselves, shared by local dev and every deployment (see README
# "Database (Turso)"). Build it from `turso db show <db> --url` (swap libsql:// for
# sqlite+libsql://) and a token from `turso db tokens create <db>`.
DATABASE_URL=sqlite+libsql://<db>-<org>.turso.io/?authToken=<token>

