# Read by docker-compose.yml for image tags and container env vars - copy to
# ".env" (same directory as docker-compose.yml) and fill in for a real deployment.
# Not used by `pnpm dev`/`uvicorn --reload` - see backend/.env.example for that.

# Set by the GitHub Actions deploy job automatically (as ghcr.io/<owner>/<repo>);
# only needed here for a manual `docker compose pull` on the server outside of CI.
IMAGE_BASE=ghcr.io/<owner>/<repo>
TAG=latest

SECRET_KEY=change-this-super-secret-key-in-production
CORS_ORIGINS=http://localhost

# Hosted Postgres (Neon) connection string - the same one used in backend/.env for
# local dev, so the Docker Compose stack and local dev share one database (see
# README "Switching to Postgres (Neon)"). Get this from the Neon dashboard's
# "Connection string" and keep sslmode=require/channel_binding=require as given.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require&channel_binding=require

# Optional SMTP for monthly accountant reports - leave blank to keep mock mode
# (emails written to /data inside the backend container instead of being sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=reports@smartreceipt.local
