# Hosted Turso (libSQL) database - the only storage for users, invoices and the
# receipt files themselves, shared by local dev and every deployment (see README
# "Database (Turso)"). Build it from `turso db show <db> --url` (swap libsql:// for
# sqlite+libsql://) and a token from `turso db tokens create <db>`.
DATABASE_URL=sqlite+libsql://<db>-<org>.turso.io/?authToken=<token>

# Secret used to sign auth JWTs - change this in production
SECRET_KEY=change-this-super-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# WorldTimeAPI endpoint used to stamp uploads with an external timestamp
WORLD_TIME_API_URL=http://worldtimeapi.org/api/ip

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Deployed frontend origin (e.g. https://your-app.vercel.app), added to
# CORS_ORIGINS above - set this on Render once the Vercel frontend is deployed.
FRONTEND_URL=

# Port to bind to. Render sets this automatically - leave unset for local dev.
# PORT=8000
