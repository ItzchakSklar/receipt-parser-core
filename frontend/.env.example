# Leave unset for local dev (pnpm dev proxies /api to localhost:8000, see
# vite.config.ts) and for the docker-compose/nginx setup (same-origin /api).
# On Vercel, set this to the deployed Render backend's URL, including /api:
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_API_BASE_URL=
